<?xml version="1.0" encoding="UTF-8"?>
<labwc_config>
  <core>
    <adaptiveSync>no</adaptiveSync>
    <allowTearing>yes</allowTearing>
    <gap>1</gap>
  </core>
  <keyboard>
    <keybind>
      <action>
        <name>NextWindow</name>
      </action>
      <key>W-Tab</key>
    </keybind>
    <keybind>
      <action>
        <name>PreviousWindow</name>
      </action>
      <key>W-S-Tab</key>
    </keybind>
    <keybind>
      <action>
        <command>foot</command>
        <name>Execute</name>
      </action>
      <key>W-Grave</key>
    </keybind>
    <keybind>
      <action>
        <command>fuzzel</command>
        <name>Execute</name>
      </action>
      <key>W-r</key>
    </keybind>
    <keybind>
      <action>
        <command>foot yazi</command>
        <name>Execute</name>
      </action>
      <key>W-e</key>
    </keybind>
    <keybind>
      <action>
        <name>Iconify</name>
      </action>
      <key>W-Backspace</key>
    </keybind>
    <keybind>
      <action>
        <name>Close</name>
      </action>
      <key>W-q</key>
    </keybind>
    <keybind>
      <action>
        <name>Kill</name>
      </action>
      <key>W-S-q</key>
    </keybind>
    <keybind>
      <action>
        <name>Exit</name>
      </action>
      <key>W-C-S-A-q</key>
    </keybind>
    <keybind>
      <action>
        <command>wlr-randr --output DP-1 --mode 1920x1080@239.964005</command>
        <name>Execute</name>
      </action>
      <key>W-C-S-A-r</key>
    </keybind>
    <keybind>
      <action>
        <name>ToggleMaximize</name>
      </action>
      <key>W-f</key>
    </keybind>
    <keybind>
      <action>
        <name>ToggleFullscreen</name>
      </action>
      <key>W-S-f</key>
    </keybind>
    <keybind>
      <action>
        <command>hyprshot --freeze --mode region --output-folder ~/Pictures/Screenshots</command>
        <name>Execute</name>
      </action>
      <key>Print</key>
    </keybind>
    <numlock>on</numlock>
    <repeatDelay>200</repeatDelay>
    <repeatRate>80</repeatRate>
  </keyboard>
  <libinput>
    <device>
      <accelProfile>flat</accelProfile>
      <category>default</category>
      <pointerSpeed>0.000000</pointerSpeed>
    </device>
  </libinput>
  <mouse>
    <context>
      <mousebind action="Press">
        <action>
          <menu>root-menu</menu>
          <name>ShowMenu</name>
        </action>
        <button>Right</button>
      </mousebind>
      <name>Root</name>
    </context>
    <context>
      <mousebind button="W-Left" action="Press">
        <action>
          <name>Focus</name>
        </action>
        <action>
          <name>Raise</name>
        </action>
      </mousebind>
      <mousebind button="W-Left" action="Drag">
        <action>
          <name>Move</name>
        </action>
      </mousebind>
      <mousebind button="W-Right" action="Press">
        <action>
          <name>Focus</name>
        </action>
        <action>
          <name>Raise</name>
        </action>
      </mousebind>
      <mousebind button="W-Right" action="Drag">
        <action>
          <name>Resize</name>
        </action>
      </mousebind>
      <name>Frame</name>
    </context>
    <context>
      <mousebind button="Left" action="Press">
        <action>
          <name>Focus</name>
        </action>
        <action>
          <name>Raise</name>
        </action>
      </mousebind>
      <mousebind button="Middle" action="Press">
        <action>
          <name>Focus</name>
        </action>
        <action>
          <name>Raise</name>
        </action>
      </mousebind>
      <mousebind button="Right" action="Press">
        <action>
          <name>Focus</name>
        </action>
        <action>
          <name>Raise</name>
        </action>
      </mousebind>
      <name>Client</name>
    </context>
  </mouse>
  <resize>
    <popupShow>Always</popupShow>
  </resize>
  <theme>
    <cornerRadius>0</cornerRadius>
    <font>
      <name>Unifont</name>
      <place>ActiveWindow</place>
      <size>0</size>
    </font>
    <font>
      <name>Unifont</name>
      <place>InactiveWindow</place>
      <size>0</size>
    </font>
  </theme>
  <windowRules>
    <windowRule>
      <action>
        <name>Iconify</name>
      </action>
      <identifier>com.obsproject.Studio</identifier>
    </windowRule>
  </windowRules>
</labwc_config>
